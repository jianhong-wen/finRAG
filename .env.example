# Copy this file to .env and fill in the values. Never commit .env.

# Connection string copied from the Neon dashboard. Keep sslmode=require.
# Environments (ADR 0005): DATABASE_URL is the Neon 'development' branch.
# `neon checkout development` writes it. Never point it at 'production' for daily work.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# The Neon 'test' branch. Database tests run only here and refuse any other database.
TEST_DATABASE_URL=

# Only for `python scripts/ingest.py --target production`. Leave unset for daily work.
# PRODUCTION_DATABASE_URL=

# Contact for SEC requests (scripts/sec_facts.py fetch). The SEC asks clients to name
# themselves and give an email address.
# SEC_USER_AGENT="finRAG research you@example.com"

# Needed only for scripts that call the model (finrag.agent).
ANTHROPIC_API_KEY=

# Optional settings
# ANTHROPIC_MODEL=claude-sonnet-5-5
# EMBED_BACKEND=hash   # offline tests only; retrieval quality is not meaningful
